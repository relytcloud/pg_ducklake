step check_metadata: 
  SELECT count(*) AS rows, count(DISTINCT row_id) AS row_ids,
         count(DISTINCT begin_snapshot) AS snapshots
  FROM iso_native_retry_inlined;

  SELECT writer, count(*) AS rows,
         max(row_id) - min(row_id) + 1 = count(*) AS contiguous,
         count(DISTINCT begin_snapshot) AS snapshots
  FROM iso_native_retry_inlined
  GROUP BY writer
  ORDER BY writer;


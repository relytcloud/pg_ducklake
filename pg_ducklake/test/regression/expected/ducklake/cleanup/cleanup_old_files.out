-------------------
 f
(1 row)

SELECT count(*) > 0 AS cleaned_files FROM ducklake.cleanup_old_files();
 cleaned_files 
---------------
 t
(1 row)

SELECT count(*) = :scheduled_base AS scheduled_queue_restored
FROM ducklake.ducklake_files_scheduled_for_deletion;

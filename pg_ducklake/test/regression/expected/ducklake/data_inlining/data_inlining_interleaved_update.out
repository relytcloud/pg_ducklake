       array_agg(r['id']::integer ORDER BY r['id']::integer) AS ids
FROM ducklake.table_changes('upstream_inline_interleave'::regclass, :first_snapshot, :first_snapshot) AS r
GROUP BY r['change_type']::text ORDER BY change_type;

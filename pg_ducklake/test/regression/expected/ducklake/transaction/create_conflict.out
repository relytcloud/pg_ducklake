-- PostgreSQL has no CREATE VIEW IF NOT EXISTS syntax; perform its no-op semantics.
DO $do$
BEGIN
  IF to_regclass('upstream_conflict_view') IS NULL THEN
    EXECUTE 'CREATE VIEW upstream_conflict_view AS SELECT 84 AS i';
  END IF;
END
$do$;

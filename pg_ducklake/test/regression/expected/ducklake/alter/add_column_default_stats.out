-- Upstream: test/sql/alter/add_column_default_stats.test
CALL ducklake.set_option('data_inlining_row_limit', 100);
CREATE TABLE upstream_add_stats_tx (a integer) USING ducklake;
BEGIN;
INSERT INTO upstream_add_stats_tx VALUES (1), (2), (3);
ALTER TABLE upstream_add_stats_tx ADD COLUMN b integer DEFAULT 42;
COMMIT;
SELECT * FROM upstream_add_stats_tx ORDER BY a;
 a | b  
---+----
 1 | 42
 2 | 42
 3 | 42
(3 rows)

SELECT s.min_value, s.max_value
FROM ducklake.ducklake_table_column_stats s
JOIN ducklake.ducklake_table t USING (table_id)
JOIN ducklake.ducklake_column c USING (table_id, column_id)
WHERE t.table_name = 'upstream_add_stats_tx' AND t.end_snapshot IS NULL
  AND c.column_name = 'b' AND c.end_snapshot IS NULL;
 min_value | max_value 
-----------+-----------
 42        | 42
(1 row)

CREATE TABLE upstream_add_stats_merge (a integer) USING ducklake;
BEGIN;
INSERT INTO upstream_add_stats_merge VALUES (10), (20), (30);
ALTER TABLE upstream_add_stats_merge ADD COLUMN b integer DEFAULT 99;
INSERT INTO upstream_add_stats_merge VALUES (40, 200);
COMMIT;
INSERT INTO upstream_add_stats_merge VALUES (50, 20);
SELECT * FROM upstream_add_stats_merge ORDER BY a;
 a  |  b  
----+-----
 10 |  99
 20 |  99
 30 |  99
 40 | 200
 50 |  20
(5 rows)

SELECT s.min_value, s.max_value
FROM ducklake.ducklake_table_column_stats s
JOIN ducklake.ducklake_table t USING (table_id)
JOIN ducklake.ducklake_column c USING (table_id, column_id)
WHERE t.table_name = 'upstream_add_stats_merge' AND t.end_snapshot IS NULL
  AND c.column_name = 'b' AND c.end_snapshot IS NULL;
 min_value | max_value 
-----------+-----------
 20        | 200
(1 row)

CREATE TABLE upstream_add_stats_delete (a integer) USING ducklake;
BEGIN;
INSERT INTO upstream_add_stats_delete VALUES (1), (2), (3);
DELETE FROM upstream_add_stats_delete;
ALTER TABLE upstream_add_stats_delete ADD COLUMN b integer DEFAULT 999;
INSERT INTO upstream_add_stats_delete VALUES (10, 5);
COMMIT;
SELECT * FROM upstream_add_stats_delete ORDER BY a;
 a  | b 
----+---
 10 | 5
(1 row)

SELECT s.min_value, s.max_value
FROM ducklake.ducklake_table_column_stats s
JOIN ducklake.ducklake_table t USING (table_id)
JOIN ducklake.ducklake_column c USING (table_id, column_id)
WHERE t.table_name = 'upstream_add_stats_delete' AND t.end_snapshot IS NULL
  AND c.column_name = 'b' AND c.end_snapshot IS NULL;
 min_value | max_value 
-----------+-----------
 5         | 5
(1 row)

DROP TABLE upstream_add_stats_tx, upstream_add_stats_merge, upstream_add_stats_delete;
CALL ducklake.set_option('data_inlining_row_limit', 0);

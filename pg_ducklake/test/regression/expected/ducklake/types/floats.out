CREATE TABLE upstream_float_real (f real) USING ducklake;
INSERT INTO upstream_float_real VALUES (1), (10), ('NaN'), (1);
SELECT count(*) FROM upstream_float_real WHERE f = 'NaN';
 count 
-------
     1
(1 row)

SELECT count(*) FROM upstream_float_real WHERE f > 'NaN';
 count 
-------

(1 row)

SELECT count(*) FROM upstream_float_real WHERE f < 'NaN';
 count 
-------
     3
(1 row)

SELECT count(*) FROM upstream_float_real WHERE f <= 'NaN';
 count 
-------
     4
(1 row)

SELECT count(*) FROM upstream_float_real WHERE f > 1;
 count 
-------
     2
(1 row)

INSERT INTO upstream_float_real VALUES ('Infinity'), ('-Infinity');
SELECT count(*) FROM upstream_float_real WHERE f > 'Infinity';
 count 
-------
     1
(1 row)

SELECT count(*) FROM upstream_float_real WHERE f >= 'Infinity';
 count 
-------
     2
(1 row)

SELECT count(*) FROM upstream_float_real WHERE f < 'Infinity';
 count 
-------

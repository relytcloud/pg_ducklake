-- Upstream: test/sql/merge/merge_multi_partition_timestamp.test
-- MERGE must compute every timestamp partition transform from the source row.
SET datestyle TO ISO;
CALL ducklake.set_option('data_inlining_row_limit', 0);
CREATE TABLE upstream_merge_multi_ts (id integer, ts timestamp) USING ducklake;
CALL ducklake.set_partition(
    'upstream_merge_multi_ts'::regclass, 'year(ts)', 'month(ts)'
);
INSERT INTO upstream_merge_multi_ts VALUES (1, TIMESTAMP '2025-01-15');
MERGE INTO upstream_merge_multi_ts AS old
USING (VALUES (2, TIMESTAMP '2025-03-20')) AS new(id, ts)
ON old.id = new.id
WHEN NOT MATCHED THEN INSERT (id, ts) VALUES (new.id, new.ts);
SELECT * FROM upstream_merge_multi_ts ORDER BY id;
 id |         ts          
----+---------------------
  1 | 2025-01-15 00:00:00
  2 | 2025-03-20 00:00:00
(2 rows)

SELECT partition_key_index, partition_value
FROM ducklake.ducklake_file_partition_value fpv
JOIN ducklake.ducklake_table t USING (table_id)
WHERE t.table_name = 'upstream_merge_multi_ts'
ORDER BY partition_key_index, partition_value;
 partition_key_index | partition_value 
---------------------+-----------------
                   0 | 2025
                   0 | 2025
                   1 | 1
                   1 | 3
(4 rows)

DROP TABLE upstream_merge_multi_ts;
